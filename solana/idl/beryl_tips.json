            ],
            "type": "pubkey"
          },
          {
            "name": "pending_authority",
            "docs": [
              "Proposed by `propose_authority`; becomes the authority when it signs `accept_authority`."
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "treasury",
            "docs": [
